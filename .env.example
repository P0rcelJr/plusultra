# Copy to .env for local development. Never commit .env.

# Postgres from `docker compose up db`
DATABASE_URL=postgresql://plusultra:plusultra@localhost:5432/plusultra

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=replace-me
AUTH_TRUST_HOST=true

# First admin, created by `pnpm db:seed`
ADMIN_EMAIL=admin@plusultra.local
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Admin

# Where uploaded files (plan PDFs, photos) are written
UPLOADS_DIR=./uploads

# Phase 1: transactional email
RESEND_API_KEY=

# Shared secret for POST /api/jobs/* (sent as the x-job-secret header) so a scheduler can run
# the daily session top-up. Generate with `openssl rand -base64 32`; the routes answer 401 while empty.
JOB_SECRET=

# Production only (compose.prod.yml)
# DOMAIN=gym.example.com
# POSTGRES_PASSWORD=replace-me
