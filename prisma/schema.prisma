generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  BOOKED
  LATE_CANCELLED
  CANCELLED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  phone           String?
  passwordHash    String     @map("password_hash")
  role            Role       @default(MEMBER)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  profile       MemberProfile?
  subscriptions Subscription[]
  authTokens    AuthToken[]

  coachedTemplates ScheduleTemplate[]
  coachedSessions  ClassSession[]

  bookings     Booking[] @relation("BookingMember")
  bookingsMade Booking[] @relation("BookingBookedBy")

  @@map("users")
}

/// Single-use links for email verification and password reset/set. Only the SHA-256
/// hash of the token is stored; the raw token travels in the email link alone.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

/// Intake data collected after email verification (decisions 20, 21, A9).
/// `healthQuestionnaire` holds the PAR-Q answers as JSON; see src/domain/parq.ts for its shape.
model MemberProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique @map("user_id")
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  cedula                String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  goals                 String?
  healthQuestionnaire   Json?     @map("health_questionnaire")
  photoFilename         String?   @map("photo_filename")
  staffNotes            String?   @map("staff_notes")
  intakeCompletedAt     DateTime? @map("intake_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_profiles")
}

/// Admin-defined plans (decision 4). Price is whole UYU (decision 18).
/// `weeklyClassQuota` null means unlimited. Archived plans (`active` false) stay attached
/// to existing subscriptions but cannot be assigned to new ones.
model MembershipPlan {
  id                   String   @id @default(cuid())
  name                 String
  monthlyPrice         Int      @map("monthly_price")
  weeklyClassQuota     Int?     @map("weekly_class_quota")
  includesTrainingPlan Boolean  @default(false) @map("includes_training_plan")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("membership_plans")
}

/// Dated membership rows (decision 19). The row covering a day is the one whose
/// half-open [startsOn, endsOn) contains it; a gap between rows is a pause.
model Subscription {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  planId    String    @map("plan_id")
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId, startsOn])
  @@map("subscriptions")
}

/// Gym-wide booking and scheduling knobs (decisions 9, A4). A single row, created with the
/// column defaults on first read by `getSettings()` in src/lib/settings.ts.
model GymSettings {
  id                      Int      @id @default(1)
  bookingWindowDays       Int      @default(7) @map("booking_window_days")
  cancelDeadlineHours     Int      @default(2) @map("cancel_deadline_hours")
  materializeHorizonWeeks Int      @default(4) @map("materialize_horizon_weeks")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("gym_settings")
}

/// Kinds of group class (decision 2), with defaults copied onto new templates and sessions.
/// Archived types (`active` false) stay on existing templates and sessions but cannot be
/// picked for new ones.
model ClassType {
  id              String   @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  capacity        Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  templates ScheduleTemplate[]
  sessions  ClassSession[]

  @@map("class_types")
}

/// Weekly template rows (decision 8). `weekday` is ISO (1 = Monday … 7 = Sunday) and `startTime`
/// is gym-local `HH:MM`; occurrences are expanded by `occurrencesFor` in src/domain/schedule.ts.
/// `startsOn` / `endsOn` are DATE columns with the same half-open meaning as subscriptions (A21).
model ScheduleTemplate {
  id              String    @id @default(cuid())
  classTypeId     String    @map("class_type_id")
  weekday         Int
  startTime       String    @map("start_time")
  durationMinutes Int       @map("duration_minutes")
  coachId         String    @map("coach_id")
  capacity        Int
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime? @map("ends_on") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  classType ClassType      @relation(fields: [classTypeId], references: [id])
  coach     User           @relation(fields: [coachId], references: [id])
  sessions  ClassSession[]

  @@index([weekday, startTime])
  @@map("schedule_templates")
}

/// A concrete class at an instant (decisions 8, A4). Rows from a template are materialized ahead
/// of time by `materializeSessions` in src/lib/schedule.ts; the unique key on (template, start)
/// makes that idempotent. A null template is a one-off session.
model ClassSession {
  id               String        @id @default(cuid())
  templateId       String?       @map("template_id")
  classTypeId      String        @map("class_type_id")
  startsAt         DateTime      @map("starts_at")
  endsAt           DateTime      @map("ends_at")
  coachId          String        @map("coach_id")
  capacity         Int
  status           SessionStatus @default(SCHEDULED)
  cancellationNote String?       @map("cancellation_note")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  template  ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  classType ClassType         @relation(fields: [classTypeId], references: [id])
  coach     User              @relation(fields: [coachId], references: [id])
  bookings  Booking[]

  @@unique([templateId, startsAt])
  @@index([startsAt])
  @@map("sessions")
}

/// A member's seat in a session (decision 9). Only BOOKED rows take a seat; LATE_CANCELLED still
/// counts against the weekly quota. `bookedById` is the member or the staff user who booked.
/// One BOOKED row per member and session is enforced by `bookSession` in src/lib/booking.ts, which
/// locks the session row before checking.
model Booking {
  id          String        @id @default(cuid())
  sessionId   String        @map("session_id")
  memberId    String        @map("member_id")
  status      BookingStatus @default(BOOKED)
  bookedById  String        @map("booked_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  cancelledAt DateTime?     @map("cancelled_at")

  session  ClassSession @relation(fields: [sessionId], references: [id])
  member   User         @relation("BookingMember", fields: [memberId], references: [id], onDelete: Cascade)
  bookedBy User         @relation("BookingBookedBy", fields: [bookedById], references: [id])

  @@index([sessionId, status])
  @@index([memberId, status])
  @@map("bookings")
}
